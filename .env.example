# VANTORIS FIRST-PARTY CORE — server-side only
# Vantoris administers this PostgreSQL database. Never expose either value to Vite/browser code.
VANTORIS_LEDGER_DATABASE_URL=postgresql://vantoris_backend:REPLACE_WITH_SECRET@db.example.invalid:5432/vantoris?sslmode=require
VANTORIS_DATABASE_SSL=require

# Generate 32 random bytes and base64-encode them. Keep the key in the deployment secret store.
# Do not rotate without a versioned re-encryption plan for existing MFA factors.
VANTORIS_MFA_ENCRYPTION_KEY=
VANTORIS_MFA_KEY_VERSION=1

# Separate AES-256-GCM key for member identity documents. Keep it in the deployment secret store.
# Keep old versioned keys available for decrypting existing documents during key rotation.
VANTORIS_DOCUMENT_KEY_VERSION=1
VANTORIS_DOCUMENT_ENCRYPTION_KEY_V1=

# Separate disposable PostgreSQL database for integration tests only.
# Never point this at the institution's live database.
VANTORIS_LEDGER_TEST_DATABASE_URL=

# OPTIONAL VANTORIS INTELLIGENCE — informational only, never in the money-control path.
# Configure only a Vantoris-controlled private OpenAI-compatible endpoint.
# The endpoint must be HTTPS in production; HTTP is accepted only for loopback development.
# If these values are absent, the assistant reports unavailable. Core services remain independent.
VANTORIS_PRIVATE_LLM_URL=
VANTORIS_PRIVATE_LLM_MODEL=
VANTORIS_PRIVATE_LLM_KEY=

# LEGACY PROVIDER SETTINGS — retained for migration audit only; the active oracle.mjs
# endpoint does not read these values and has no external-provider fallback.
# Optional self-hosted assistant endpoint. No ledger permissions are granted to it.
PRIVATE_LLM_URL=
PRIVATE_LLM_MODEL=qwen2.5:7b
PRIVATE_LLM_KEY=
